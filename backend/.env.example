# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (leave as default for local, or paste your MongoDB Atlas URI)
# If local MongoDB is not installed, the server automatically starts an embedded MongoDB instance for seamless testing.
MONGODB_URI=mongodb://localhost:27017/bloodbridge

# JWT Authentication
JWT_SECRET=bloodbridge_jwt_secret_production_key_change_in_real_deployment_2026
JWT_EXPIRES_IN=7d

# Frontend CORS
CORS_ORIGIN=http://localhost:5173
